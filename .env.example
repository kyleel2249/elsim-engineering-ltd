# ---------------------------------------------------------------------------
# ELSIM Engineering — environment configuration
# Copy to .env.local for development. Set the same keys in the Cloudflare Pages
# dashboard under Settings > Environment variables for production.
# ---------------------------------------------------------------------------

# Canonical site origin. Must match the Google Search Console URL-prefix property
# exactly (host + protocol), or sitemap <loc> entries will be rejected as
# "URL is not allowed for a Sitemap at this location".
#   Property https://elsimengineeringlimited.com     → use value below
#   Property https://www.elsimengineeringlimited.com → use https://www.elsimengineeringlimited.com
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://elsimengineeringlimited.com

# Search engine indexing.
#   true  (or unset) -> indexable, sitemap advertised
#   false            -> robots.txt disallows everything, pages carry noindex
# Set this to false on staging/preview deployments only.
NEXT_PUBLIC_SITE_INDEXABLE=true

# Google Analytics measurement ID. Set to an empty value to disable analytics
# entirely (no gtag script is loaded at all).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-E8Z0XCC54Q

# ---------------------------------------------------------------------------
# Optional: external image CDN
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_IMAGE_CDN_URL=https://res.cloudinary.com/your-cloud/image/upload
# NEXT_PUBLIC_IMAGE_CDN_PROVIDER=cloudinary

# ---------------------------------------------------------------------------
# Quotation intake (server-side only — never prefix these with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# QUOTATION_INBOX=elsimengineering@gmail.com

# ---------------------------------------------------------------------------
# Set automatically by the build scripts — do not set these by hand.
# ---------------------------------------------------------------------------
